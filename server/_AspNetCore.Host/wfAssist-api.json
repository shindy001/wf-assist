{
  "openapi": "3.1.1",
  "info": {
    "title": "WFAssist API Reference",
    "description": "API for WFAssist client."
  },
  "paths": {
    "/api/executions": {
      "get": {
        "tags": [
          "WfAssist_Executions"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetWorkflowExecutionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/executions/{id}": {
      "get": {
        "tags": [
          "WfAssist_Executions"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetWorkflowExecutionByIdResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/workflows/identities": {
      "get": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetIdentitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows/{id}": {
      "get": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetWorkflowByIdResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/workflows": {
      "post": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkflowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/workflows/{id}/rename": {
      "post": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameWorkflowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/workflows/{id}/updateData": {
      "post": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkflowDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/workflows/events": {
      "get": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SseItemOfNotification"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows/{id}/queueExecution": {
      "post": {
        "tags": [
          "WfAssist_Workflows"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunWorkflowResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateWorkflowRequest": {
        "required": [
          "name",
          "data"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/WorkflowDataDto"
          }
        }
      },
      "EdgeDto": {
        "required": [
          "id",
          "source",
          "target"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      },
      "ExecutionStatus": {
        "enum": [
          "Queued",
          "Running",
          "Completed",
          "Failed"
        ]
      },
      "GetIdentitiesResponse": {
        "required": [
          "identities"
        ],
        "type": "object",
        "properties": {
          "identities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkFlowIdentityDto"
            }
          }
        }
      },
      "GetWorkflowByIdResponse": {
        "required": [
          "item"
        ],
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/WorkflowDto"
          }
        }
      },
      "GetWorkflowExecutionByIdResponse": {
        "required": [
          "id",
          "status",
          "dataSnapshot"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/ExecutionStatus"
          },
          "dataSnapshot": {
            "$ref": "#/components/schemas/JsonDocument"
          },
          "processingResults": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ProcessingResult"
            }
          }
        }
      },
      "GetWorkflowExecutionsResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowExecutionDto"
            }
          }
        }
      },
      "HttpHeaderDto": {
        "required": [
          "name",
          "value"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "JsonDocument": { },
      "NodeDto": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/NodeDtoRequestNodeDto"
          },
          {
            "$ref": "#/components/schemas/NodeDtoHeadersNodeDto"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "RequestNode": "#/components/schemas/NodeDtoRequestNodeDto",
            "HeadersNode": "#/components/schemas/NodeDtoHeadersNodeDto"
          }
        }
      },
      "NodeDtoHeadersNodeDto": {
        "required": [
          "id",
          "size",
          "position"
        ],
        "properties": {
          "type": {
            "enum": [
              "HeadersNode"
            ],
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HttpHeaderDto"
            }
          },
          "id": {
            "type": "string"
          },
          "size": {
            "$ref": "#/components/schemas/SizeDto"
          },
          "position": {
            "$ref": "#/components/schemas/PositionDto"
          }
        }
      },
      "NodeDtoRequestNodeDto": {
        "required": [
          "requestType",
          "url",
          "id",
          "size",
          "position"
        ],
        "properties": {
          "type": {
            "enum": [
              "RequestNode"
            ],
            "type": "string"
          },
          "requestType": {
            "$ref": "#/components/schemas/RequestTypeDto"
          },
          "url": {
            "type": "string"
          },
          "requestBody": {
            "type": [
              "null",
              "string"
            ]
          },
          "id": {
            "type": "string"
          },
          "size": {
            "$ref": "#/components/schemas/SizeDto"
          },
          "position": {
            "$ref": "#/components/schemas/PositionDto"
          }
        }
      },
      "Notification": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/NotificationWorkflowExecutionEnded"
          },
          {
            "$ref": "#/components/schemas/NotificationWorkflowExecutionStarted"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "WorkflowExecutionEnded": "#/components/schemas/NotificationWorkflowExecutionEnded",
            "WorkflowExecutionStarted": "#/components/schemas/NotificationWorkflowExecutionStarted"
          }
        }
      },
      "NotificationWorkflowExecutionEnded": {
        "required": [
          "executionId",
          "workflowId",
          "workflowName",
          "status"
        ],
        "properties": {
          "type": {
            "enum": [
              "WorkflowExecutionEnded"
            ],
            "type": "string"
          },
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "workflowId": {
            "type": "string",
            "format": "uuid"
          },
          "workflowName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "NotificationWorkflowExecutionStarted": {
        "required": [
          "executionId",
          "workflowId",
          "workflowName"
        ],
        "properties": {
          "type": {
            "enum": [
              "WorkflowExecutionStarted"
            ],
            "type": "string"
          },
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "workflowId": {
            "type": "string",
            "format": "uuid"
          },
          "workflowName": {
            "type": "string"
          }
        }
      },
      "PositionDto": {
        "required": [
          "x",
          "y"
        ],
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "ProcessingResult": {
        "required": [
          "isSuccessful",
          "valueType"
        ],
        "type": "object",
        "properties": {
          "isSuccessful": {
            "type": "boolean"
          },
          "valueType": {
            "$ref": "#/components/schemas/ProcessResultValueType"
          },
          "data": { },
          "errorMessage": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProcessResultValueType": {
        "enum": [
          "None",
          "JsonDocument",
          "Error"
        ]
      },
      "RenameWorkflowRequest": {
        "required": [
          "newName"
        ],
        "type": "object",
        "properties": {
          "newName": {
            "type": "string"
          }
        }
      },
      "RequestTypeDto": {
        "enum": [
          "Get",
          "Post",
          "Put",
          "Patch",
          "Delete"
        ]
      },
      "RunWorkflowResponse": {
        "required": [
          "runId"
        ],
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SizeDto": {
        "required": [
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SseItemOfNotification": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Notification"
          },
          "eventType": {
            "type": [
              "null",
              "string"
            ]
          },
          "eventId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reconnectionInterval": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateWorkflowDataRequest": {
        "required": [
          "data"
        ],
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkflowDataDto"
          }
        }
      },
      "WorkflowDataDto": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeDto"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EdgeDto"
            }
          }
        }
      },
      "WorkflowDto": {
        "required": [
          "id",
          "name",
          "data"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/WorkflowDataDto"
          }
        }
      },
      "WorkflowExecutionDto": {
        "required": [
          "id",
          "status",
          "dataSnapshot"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/ExecutionStatus"
          },
          "dataSnapshot": {
            "$ref": "#/components/schemas/JsonDocument"
          },
          "processingResults": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ProcessingResult"
            }
          }
        }
      },
      "WorkFlowIdentityDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "WfAssist_Executions"
    },
    {
      "name": "WfAssist_Workflows"
    }
  ]
}